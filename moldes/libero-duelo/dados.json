            "b": "Qualquer norma de eficácia limitada"
          },
          {
            "criterio": "Quem propõe",
            "a": "O titular do direito (ou legitimado do coletivo)",
            "b": "Legitimados do art. 103"
          },
          {
            "criterio": "Quem julga",
            "a": "Depende da autoridade omissa",
            "b": "STF"
          },
          {
            "criterio": "Decisão",
