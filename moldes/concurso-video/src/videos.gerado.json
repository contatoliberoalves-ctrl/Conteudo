,"195"],["um minuto","1 minuto"]],"cenas":[{"tipo":"gancho","selo":"Cai em prova","linhas":["Imunidade","ou [[isenção]]?"],"sub":"Nas duas você não paga.","fala":"Imunidade e isenção: nas duas, você não paga o tributo. Mas, pra banca, são coisas bem diferentes. Em um minuto, você nunca mais confunde."},{"tipo":"versus","titulo":"A diferença","lados":[{"nome":"Imunidade","itens":[{"t":"Está na **Constituição**","em":"Constituição"},{"t":"Limita o poder de tributar","em":"limita"},{"t":"O tributo nem chega a nascer","em":"nascer"}]},{"nome":"Isenção","itens":[{"t":"Está na **lei**","em":"lei"},{"t":"O fato gerador acontece","em":"acontece"},{"t":"A lei dispensa o pagamento","em":"dispensa"}]}],"fala":"Imunidade está na Constituição: limita o poder de tributar, e o tributo nem chega a nascer. Isenção está na lei: o fato gerador acontece, mas a lei dispensa o pagamento."},{"tipo":"analogia","titulo":"Pensa num prédio","lados":[{"nome":"Imunidade","desenho":"parede","t":"A porta nem existe na planta","em":"planta"},{"nome":"Isenção","desenho":"porta","t":"A porta existe, mas você tem passe livre","em":"passe"}],"fala":"Pensa num prédio. Imunidade é uma porta que nem existe na planta. Isenção é uma porta que existe, mas você tem passe livre. E passe livre pode ser cancelado por outra lei."},{"tipo":"fichas","titulo":"Na prática","itens":[{"rot":"Templos de qualquer culto","valor":"Imunes","detalhe":"CF, art. 150, VI, b","em":"templos"},{"rot":"IR de quem tem doença grave","valor":"Isento","detalhe":"Lei 7.713/88, art. 6º, XIV","em":"doença"}],"fala":"Na prática: templos não pagam imposto por imunidade, porque está na Constituição. Quem tem doença grave não paga imposto de renda por isenção, porque está numa lei."},{"tipo":"lei","selo":"Pegadinha","ref":"CF, art. 195, § 7º","texto":"São [[isentas]] de contribuição para a seguridade social as entidades beneficentes de assistência social que atendam às exigências estabelecidas em lei.","risca":"isentas","troca":"imunes","em":"isentas","emTroca":"imunidade","nota":"Para o STF, é imunidade","fala":"Agora, a pegadinha. O artigo cento e noventa e cinco da Constituição diz que entidades beneficentes são isentas de contribuição. Mas, se está na Constituição, é imunidade. E é isso que o Supremo diz."},{"tipo":"frase","linhas":["Constituição:","[[imunidade]]","Lei: isenção"],"fala":"Grava: na Constituição, imunidade. Na lei, isenção."},{"tipo":"cta","produto":"curso","titulo":["Revise isso em","[[flashcards]]"],"comenta":"FLASH","fala":"Comenta FLASH que eu te mando os flashcards de Tributário do Curso Concurso com Líbero."}],"tempo":{"duracao":67.199,"palavras":[{"w":"Imunidade","ini":0,"fim":0.72,"cena":0},{"w":"e","ini":0.778,"fim":0.882,"cena":0},{"w":"isenção:","ini":0.906,"fim":1.695,"cena":0},{"w":"nas","ini":2.09,"fim":2.252,"cena":0},{"w":"duas,","ini":2.31,"fim":2.81,"cena":0},{"w":"você","ini":2.914,"fim":3.123,"cena":0},{"w":"não","ini":3.181,"fim":3.297,"cena":0},{"w":"paga","ini":3.344,"fim":3.599,"cena":0},{"w":"o","ini":3.646,"fim":3.68,"cena":0},{"w":"tributo.","ini":3.715,"fim":4.365,"cena":0},{"w":"Mas,","ini":4.899,"fim":5.178,"cena":0},{"w":"pra","ini":5.213,"fim":5.341,"cena":0},{"w":"banca,","ini":5.387,"fim":5.875,"cena":0},{"w":"são","ini":5.979,"fim":6.188,"cena":0},{"w":"coisas","ini":6.223,"fim":6.606,"cena":0},{"w":"bem","ini":6.687,"fim":6.873,"cena":0},{"w":"diferentes.","ini":6.92,"fim":7.79,"cena":0},{"w":"Em","ini":7.976,"fim":8.127,"cena":0},{"w":"um","ini":8.197,"fim":8.255,"cena":0},{"w":"minuto,","ini":8.301,"fim":8.916,"cena":0},{"w":"você","ini":9.056,"fim":9.323,"cena":0},{"w":"nunca","ini":9.439,"fim":9.706,"cena":0},{"w":"mais","ini":9.752,"fim":9.996,"cena":0},{"w":"confunde.","ini":10.066,"fim":10.786,"cena":0},{"w":"Imunidade","ini":11.18,"fim":11.842,"cena":1},{"w":"está","ini":11.877,"fim":12.051,"cena":1},{"w":"na","ini":12.098,"fim":12.167,"cena":1},{"w":"Constituição:","ini":12.214,"fim":13.131,"cena":1},{"w":"limita","ini":13.526,"fim":13.92,